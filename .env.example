MONGO_ROOT_USERNAME=wa_relay
MONGO_ROOT_PASSWORD=change-me-mongo-password
MONGODB_URI=mongodb://wa_relay:change-me-mongo-password@mongo:27017/wa-relay?authSource=admin
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=3000
# QR page (/qr) HTTP Basic Auth — true/false (default true)
QR_BASIC_AUTH=true
PATTERNS=urgent|sos
BAILEYS_AUTH_DIR=/app/baileys_auth
# Optional FCM (Android, and iOS if using Firebase Messaging)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Optional direct APNs for iOS (no Firebase). Use sandbox for debug builds.
# Create a .p8 key in Apple Developer → Keys → Apple Push Notifications service.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.warelay.app
# Either paste the key (with \n for newlines) or mount a file:
APNS_KEY_P8=
# APNS_KEY_PATH=/run/secrets/AuthKey.p8
APNS_PRODUCTION=false
